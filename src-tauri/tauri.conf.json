{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalPDF",
  "mainBinaryName": "LocalPDF",
  "version": "0.1.0",
  "identifier": "app.localpdf.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Offline PDF tools in your right-click menu",
    "longDescription": "Merge, compress, split, rotate, convert, unlock and password-protect PDFs from the Windows Explorer or macOS Finder right-click menu. Files are processed on your computer and never uploaded.",
    "copyright": "LocalPDF contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "engines/": "engines/"
    },
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
