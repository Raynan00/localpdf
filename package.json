{
  "name": "localpdf",
  "private": true,
  "version": "0.1.0",
  "description": "Offline PDF tools in your right-click menu: merge, compress, split, rotate, convert, unlock and protect PDFs without uploading them.",
  "keywords": [
    "pdf",
    "offline",
    "privacy",
    "merge-pdf",
    "compress-pdf",
    "split-pdf",
    "pdf-to-word",
    "pdf-to-jpg",
    "context-menu",
    "tauri"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "engines": "node scripts/fetch-engines.mjs",
    "app:build": "node scripts/fetch-engines.mjs && tauri build"
  },
  "dependencies": {
    "@radix-ui/react-toggle-group": "1.1.1",
    "@tauri-apps/api": "2.12.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
